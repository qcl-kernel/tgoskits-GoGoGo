+void gicv3_trace_ppi27_state(GICv3CPUState *cs, int level)
+{
+    ARMCPU *cpu = ARM_CPU(cs->cpu);
+    CPUARMState *env = &cpu->env;
+    const int irq = 27;
+    uint64_t gic_state;
+    uint64_t cpu_state;
+    uint64_t execution_state;
+
+    gic_state = level | (uint64_t)extract32(cs->gicr_ienabler0, irq, 1) << 1 |
+                (uint64_t)extract32(cs->gicr_ipendr0, irq, 1) << 2 |
+                (uint64_t)extract32(cs->gicr_iactiver0, irq, 1) << 3 |
+                (uint64_t)extract32(cs->edge_trigger, irq, 1) << 4 |
+                (uint64_t)(uint16_t)cs->hppi.irq << 8 |
+                (uint64_t)(uint8_t)cs->hppi.grp << 24 |
+                (uint64_t)cs->hppi.prio << 32;
+    cpu_state = env->irq_line_state |
+                (uint64_t)qatomic_read(&cs->cpu->interrupt_request) << 32;
+    execution_state = env->daif | (uint64_t)arm_current_el(env) << 32 |
+                      (uint64_t)!!cs->cpu->halted << 40 |
+                      (uint64_t)qatomic_read(&cs->cpu->thread_kicked) << 41 |
+                      (uint64_t)qemu_cpu_is_self(cs->cpu) << 42 |
+                      (uint64_t)cs->cpu->running << 43 |
+                      (uint64_t)cs->cpu->has_waiter << 44 |
+                      (uint64_t)cs->cpu->exit_request << 45;
+
+    trace_gicv3_redist_ppi27_state(
+        cs->cpu->cpu_index, qemu_clock_get_ns(QEMU_CLOCK_REALTIME), gic_state,
+        cpu_state, execution_state, env->cp15.c14_timer[GTIMER_VIRT].cval,
+        env->pc, env->xregs[30], env->xregs[31]);
+}
