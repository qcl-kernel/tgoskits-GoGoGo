+uint64_t arm_ax_diag_thread_cpu_ns(void)
+{
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) != 0) {
+        return 0;
+    }
+    return (uint64_t)ts.tv_sec * NANOSECONDS_PER_SECOND + ts.tv_nsec;
+}
+
+static void ax_diag_record_virt_program(ARMCPU *cpu, int timeridx)
+{
+    uint64_t cval = cpu->env.cp15.c14_timer[timeridx].cval;
+
+    if (CPU(cpu)->cpu_index != 2 || timeridx != GTIMER_VIRT ||
+        qatomic_read(&cpu->ax_diag_virt_program_cval) == cval) {
+        return;
+    }
+
+    qatomic_set(&cpu->ax_diag_virt_program_host_ns,
+                qemu_clock_get_ns(QEMU_CLOCK_REALTIME));
+    qatomic_set(&cpu->ax_diag_virt_program_thread_cpu_ns,
+                arm_ax_diag_thread_cpu_ns());
+    qatomic_set(&cpu->ax_diag_virt_program_tid, qemu_get_thread_id());
+    qatomic_set(&cpu->ax_diag_virt_program_cval, cval);
+}
