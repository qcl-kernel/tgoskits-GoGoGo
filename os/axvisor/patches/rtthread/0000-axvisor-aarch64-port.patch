-    rt_uint8_t gpioie;
-
-#ifdef RT_USING_SMP
-    rt_base_t level;
-#endif
-
-    if (pin < 0 || pin >= PL061_GPIO_NR)
-    {
-        return -RT_EINVAL;
-    }
-
-#ifdef RT_USING_SMP
-    level = rt_spin_lock_irqsave(&_pl061.spinlock);
-#endif
-
-    if (enabled)
-    {
-        gpioie = pl061_read8(GPIOIE) | mask;
-    }
-    else
-    {
-        gpioie = pl061_read8(GPIOIE) & ~mask;
-    }
