-    {
-        { volatile unsigned int *_u = (volatile unsigned int *)0x09000000; *_u = 'P'; }
-        rt_hw_dsb();
-        eth_device_ready(&dev->parent);
-    }
-}
-
 static rt_err_t virtio_net_tx(rt_device_t dev, struct pbuf *p)
 {
@@ -68,7 +47,5 @@ static rt_err_t virtio_net_tx(rt_device_t dev, struct pbuf *p)
     virtio_alloc_desc(virtio_dev, VIRTIO_NET_QUEUE_TX);
     virtio_alloc_desc(virtio_dev, VIRTIO_NET_QUEUE_TX);
 
