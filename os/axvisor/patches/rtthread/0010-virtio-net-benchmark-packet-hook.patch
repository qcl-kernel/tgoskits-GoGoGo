 }
 
 static rt_err_t virtio_net_tx(rt_device_t dev, struct pbuf *p)
@@ -151,3 +151,4 @@ static rt_err_t virtio_net_init(rt_device_t dev)
     queue_rx->used_idx = queue_rx->used->idx;
+    virtio_net_dev->rx_irq_used_idx = queue_rx->used->idx;
 
     queue_tx->avail->flags = VIRTQ_AVAIL_F_NO_INTERRUPT;
@@ -214,8 +215,27 @@ static void virtio_net_isr(int irqno, void *param)
 
     if (queue_rx->used_idx != queue_rx->used->idx)
     {
+        rt_uint16_t scan_idx = virtio_net_dev->rx_irq_used_idx;
+        rt_uint16_t used_idx = queue_rx->used->idx;
+
         rt_hw_dsb();
