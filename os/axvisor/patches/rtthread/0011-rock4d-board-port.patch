diff --git a/bsp/qemu-virt64-aarch64/applications/main.c b/bsp/qemu-virt64-aarch64/applications/main.c
index ab5481a..f9c6e72 100644
--- a/bsp/qemu-virt64-aarch64/applications/main.c
+++ b/bsp/qemu-virt64-aarch64/applications/main.c
@@ -1,12 +1,37 @@
 /*
  * Axvisor RT-Thread guest entry. Keep this minimal: the RT-IPC server is
- * initialized by INIT_APP_EXPORT, and benchmarks run only on demand so they
- * do not contend with the network service during latency measurements.
+ * initialized by INIT_APP_EXPORT. On the physical board there is no
+ * interactive console feed, so the complete benchmark suite is started
+ * automatically after the RT-IPC task has had time to settle.
  */
 #include <rtthread.h>
 
 int main(void)
 {
     rt_kprintf("Axvisor RT-Thread guest ready\n");
     return 0;
 }
+
+/* Run the complete benchmark suite used by the QEMU runner. */
+static void rtbench_auto_entry(void *parameter)
+{
+    (void)parameter;
+    rt_thread_delay(rt_tick_from_millisecond(30000));
+    {
+        char command[] = "benchmark 10";
+        extern int msh_exec(char *cmd, rt_size_t length);
+        (void)msh_exec(command, sizeof(command) - 1);
+    }
+}
+
+static int rtbench_auto_init(void)
+{
+    rt_thread_t tid = rt_thread_create("rtbench_auto", rtbench_auto_entry,
+                                       RT_NULL, 4096, 20, 10);
+    if (tid)
+    {
+        rt_thread_startup(tid);
+    }
+    return 0;
+}
+INIT_APP_EXPORT(rtbench_auto_init);
